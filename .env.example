# ===== LLM =====
# OpenAI 兼容端点。DeepSeek 官方为 https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# 模型名必须是服务商支持的准确 ID（DeepSeek 官方为 deepseek-flash / deepseek-v4-pro）
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=512
# 可重试错误（429/5xx/网络）的最大重试次数，0 表示不重试
LLM_MAX_RETRIES=2
# 重试基础退避（毫秒），按 2^n 指数增长并叠加抖动
LLM_RETRY_BASE_DELAY_MS=800

# ===== OneBot v11（NapCat 正向 WebSocket）=====
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 与 NapCat 的 token 保持一致；留空表示不校验
ONEBOT_ACCESS_TOKEN=
ONEBOT_RECONNECT_MIN_MS=1000
ONEBOT_RECONNECT_MAX_MS=30000

# ===== 机器人 =====
# 机器人 QQ 号；留空则从 OneBot 事件里自动学习
BOT_SELF_ID=
# 回复前模拟打字延迟上限（毫秒），0 关闭
BOT_TYPING_DELAY_MAX_MS=0
# 单条消息字符上限，超出自动分片
BOT_MAX_MESSAGE_CHARS=1500

# ===== 触发策略 =====
# 群聊是否必须 @ 才回复
TRIGGER_REQUIRE_AT_IN_GROUP=true
# 同群最小回复间隔（毫秒）
TRIGGER_GROUP_COOLDOWN_MS=3000

# ===== 主动插话（默认关闭）=====
# 总开关。开启后，未 @ 的消息会被攒起来批量判断，而不是逐条掷骰子
INTERJECT_ENABLED=false
# allowlist=只在 INTERJECT_GROUPS 里的群生效；all=所有群
INTERJECT_SCOPE=allowlist
# 允许插话的群号，逗号分隔
INTERJECT_GROUPS=
# 攒够多少条消息才判断一次（越大越省 token）
INTERJECT_MIN_MESSAGES=8
# 首条消息最多等多久后强制判断（毫秒）
INTERJECT_MAX_WAIT_MS=180000
# 两轮插话之间的冷却（毫秒），默认 10 分钟
INTERJECT_COOLDOWN_MS=600000
# 每群每小时最多插话几次
INTERJECT_MAX_PER_HOUR=4
# 模型判断「该接」后的最终概率（1=只要判断该接就接）
INTERJECT_RATE=1

# ===== 上下文 =====
CONTEXT_MAX_HISTORY_MESSAGES=20
CONTEXT_HISTORY_WINDOW_MINUTES=120
CONTEXT_MAX_CHARS=6000

# ===== 多模态（图片识别）=====
# 需要模型支持 vision；DeepSeek 的 deepseek-flash 支持，deepseek-v4-pro 不支持
VISION_ENABLED=true
# 单条消息最多识别几张图
VISION_MAX_IMAGES=2

# ===== 其他 =====
DATA_DIR=data
PERSONA_FILE=config/persona.json
LOG_LEVEL=info

# ---------- 部署路径（可选，watchdog 与面板用） ----------
# 不设时 watchdog 按脚本自身位置推导项目根，面板用 process.execPath。
# Node 独立运行时目录。必须是高完整性级别目录（如用户目录），
# 否则子进程无法写 C 盘 TEMP，本地语音转写会 EPERM。
# WHALE_NODE_RUNTIME=C:\Users\<用户名>\.whale-chan-runtime\node-v22.22.2-win-x64
# 项目根（一般不用设）
# WHALE_ROOT=
# QQ 安装目录与 NapCat 版本（自动启动用）
# WHALE_QQ_DIR=D:\Program Files\Tencent\QQNT
# WHALE_NAPCAT_VER=9.9.33-52230

# ---------- 生图后端 ----------
# gemini = 走云端（本机显存 ~0，需要本地适配层 scripts/gemini_server.py）
# comfy  = 走本地 ComfyUI（可控性强，但占 4~5GB 显存）
IMAGE_BACKEND=comfy

# Gemini 生图适配层（IMAGE_BACKEND=gemini 时生效）
# 启动：python scripts/gemini_server.py
GEMINI_PAINT_ENABLED=false
GEMINI_PAINT_URL=http://127.0.0.1:5052
GEMINI_PAINT_TIMEOUT_MS=240000

# Gemini 凭据：用 scripts/get_gemini_cookie.py 获取后写入
# scripts/gemini-cookies.json（该文件已被 gitignore，不会提交）
# 格式：{"__Secure-1PSID": "g.a000...", "__Secure-1PSIDTS": "sidts-..."}
# 代理（直连 Gemini 不通时必须配）
# GEMINI_PROXY=socks5h://127.0.0.1:10808

